# Enable the built-in certificate bundle for TLS server verification
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Use the project partition table so the TLS MQTT app has room to grow.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-C6 is 2.4 GHz Wi-Fi only.
CONFIG_SATMON_WIFI_SSID=""
CONFIG_SATMON_WIFI_PASSWORD=""
CONFIG_SATMON_WIFI_CONN_MAX_RETRY=-1

# Local Mosquitto-style MQTT brokers usually use plain MQTT on port 1883.
CONFIG_SATMON_CERT_VALIDATE_NONE=y
CONFIG_SATMON_MQTT_BROKER_URI="mqtt://192.168.1.77:1883"

# MQTT payload identity and UTC time sync.
CONFIG_SATMON_NODE_PROFILE_SAT01_MPU=y
CONFIG_SATMON_SNTP_SERVER="pool.ntp.org"
CONFIG_SATMON_SNTP_SYNC_TIMEOUT_MS=10000

# SatMon node telemetry defaults.
CONFIG_SATMON_MPU_MQTT_TOPIC="satmon/mpu9265"
CONFIG_SATMON_MPU_PUBLISH_INTERVAL_MS=1000
CONFIG_SATMON_LED_ENABLE=y
CONFIG_SATMON_LED_GPIO=8
CONFIG_SATMON_LED_BOOT_BLINK_TEST=y
CONFIG_SATMON_LED_COMMAND_TOPIC_PREFIX="satmon/commands"
